# btcbot settings - copy to .env and edit.

# paper = fake money on real Kalshi prices (default)
# demo  = Kalshi's demo exchange (fake money, real order flow)
# live  = REAL MONEY (locked until the paper report says PASS)
MODE=paper

# Kalshi API key - only needed for demo/live.
# kalshi.com (or demo.kalshi.co) -> Account & security -> API keys -> save the .pem file here
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem

# Markets: KXBTC15M = 15-min up/down, KXBTCD = hourly above/below, KXBTC = hourly ranges
SERIES=KXBTC15M,KXBTCD

# Money limits (dollars)
BANKROLL=100
MAX_TRADE_DOLLARS=5
MAX_OPEN_DOLLARS=15
MAX_DAILY_LOSS_DOLLARS=10
MAX_CONSECUTIVE_LOSSES=5

# Entry rules
MIN_EDGE=0.04          # dollars per $1 contract after fees, worst-case volatility
KELLY_FRACTION=0.10
MIN_PRICE=0.10
MAX_PRICE=0.90

# Exits
STOP_LOSS_PCT=0.50     # sell if the bid drops 50% below what you paid (0 = hold to settlement)
TP_UP_PCT=0.60         # UP bets: take profit at +60% over what you paid
TP_DOWN_PCT=0.40       # DOWN bets: take profit at +40% (0 = use the bot's fair-value target)
EDGE_EXIT=true         # sell when the market pays more than the bot's fair value

# Phone alerts (optional): install the free "ntfy" app, subscribe to a long random
# topic name, and put the same name here.
NTFY_TOPIC=

# Your hourly pay - the report shows wins/losses as hours of work
HOURLY_WAGE=16.90

# Live-trading lock. Leave blank until `python -m btcbot report` says PASS.
LIVE_CONFIRM=
